# Copy this file to .env.local for local development, and add the same
# keys in Vercel → Project → Settings → Environment Variables for production.
#
# Only VITE_-prefixed variables are exposed to the browser. Everything else
# (Stripe secret key, Resend key, Supabase service role key) lives ONLY as
# Supabase Edge Function secrets — see supabase/README.md — never in this file
# and never in Vercel, since this is a frontend-only deploy.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe → Developers → API keys (publishable key only — safe for the browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Used in a couple of places to build absolute links (e.g. password reset emails
# if you ever move that logic client-side). Set to your real domain in production.
VITE_SITE_URL=http://localhost:5173
